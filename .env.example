# Copy to .env on the host. Never commit .env or print its values.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOWED_CHAT_ID=123456789
OPENROUTER_API_KEY=your-openrouter-api-key
GEMINI_API_KEY_PRIMARY=your-first-gemini-api-key
GEMINI_API_KEY_SECONDARY=your-second-gemini-api-key
AGENT_WEBHOOK_TOKEN=your-shared-sensor-token

# needed when use headless_browser plugin
TWITTER_AUTH_COOKIE=use_user_tools_get_session_cookies_

# only use when agent need to post something on threads
#THREADS_SESSION_ID=use_user_tools_get_session_cookies_

# Only needed when config.yaml sets db_type: postgres.
POSTGRES_DSN=postgresql+psycopg://user:password@localhost:5432/devi_subhadra
